# ============================================================
# NEXUS TRUST — Environment Variables
# Copy to .env.local. Add the same names in the host dashboard.
# Placeholders only. Do not put real secrets in this file.
# The app builds and serves /status when required values are empty.
# ============================================================

# === REQUIRED: World App ===
# Any one of these app id names satisfies the status check.
# Value from https://developer.worldcoin.org — looks like app_...
NEXT_PUBLIC_WORLD_APP_ID=
NEXT_PUBLIC_APP_ID=
WORLD_APP_ID=

# Action id registered in the Developer Portal. Defaults to nexus-trust-payment-2026.
NEXT_PUBLIC_WORLD_ACTION_ID=nexus-trust-payment-2026
WORLD_ACTION_ID=nexus-trust-payment-2026

# Developer Portal API key. Either name satisfies the status check.
# Server-only. Never prefix with NEXT_PUBLIC_.
DEV_PORTAL_API_KEY=
WORLD_API_KEY=

# Treasury address that receives MiniKit payments (0x...).
NEXT_PUBLIC_PAYMENT_RECEIVER=

# === REQUIRED: Postgres ===
# Example: postgresql://user:password@host:5432/nexustrust?sslmode=require
DATABASE_URL=

# === REQUIRED: Upstash Redis (or Vercel KV aliases) ===
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# === OPTIONAL: cron auth ===
# Vercel Cron sends Authorization: Bearer $CRON_SECRET.
# Either name is accepted by /api/agent-run. Generate with: openssl rand -hex 32
AGENT_CRON_SECRET=
CRON_SECRET=

# === OPTIONAL: AI and partners ===
GROK_API_KEY=
GROK_BRAIN_URL=https://grok-world-orchestrator.vercel.app
DEFILLAMA_BASE_URL=https://yields.llama.fi
EXA_API_KEY=
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
OKTA_HUMAN_PRINCIPAL_KEY=

# === OPTIONAL: Supabase (legacy metrics path; the app reads Postgres) ===
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# === OPTIONAL: compliance ===
# Comma-separated ISO country allowlist. Empty disables the allowlist.
TARGET_JURISDICTIONS=ES,MX,CO,AR,PE,CL,EC,GT,HN,BO,PY,UY,BR,PT
CONSENT_VERSION=v1

# === OPTIONAL: chain deploy (scripts only, not required to boot the app) ===
DEPLOYER_PRIVATE_KEY=
WORLD_CHAIN_RPC_URL=https://worldchain-mainnet.g.alchemy.com/public
CELO_PRIVATE_KEY=
CELO_RPC_URL=https://forno.celo.org
CELO_CONTRACT_ADDRESS=
CELOSCAN_API_KEY=

# === OPTIONAL: local deploy scripts ===
VERCEL_TOKEN=
DOMAIN=
NEXT_PUBLIC_WALLETCONNECT_ID=
